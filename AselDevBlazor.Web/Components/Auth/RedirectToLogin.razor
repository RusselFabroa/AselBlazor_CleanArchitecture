@using Microsoft.AspNetCore.Components.Authorization
@using AselDevBlazor.Web.Services
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject SsoNavigationService SsoNavigation

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentUrl = NavManager.Uri;
        var baseUrl = NavManager.BaseUri;
        var returnUrl = currentUrl.Replace(baseUrl, "/");
        var state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            Snackbar.Add("You are signed in but not authorized to access this page.", Severity.Error);
            NavManager.NavigateTo(
                $"/unauthorized?urlReturn={Uri.EscapeDataString(returnUrl)}",
                forceLoad: false);
            return;
        }

        Snackbar.Add("Please sign in to continue.", Severity.Warning);
        NavManager.NavigateTo(SsoNavigation.BuildLoginUrl(returnUrl), SsoNavigation.Settings.IsClient);
    }
}
