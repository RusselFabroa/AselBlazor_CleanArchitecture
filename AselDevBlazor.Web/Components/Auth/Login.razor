@page "/login"
@attribute [AllowAnonymous]
@using AselDevBlazor.Web.Components.Layout
@layout EmptyLayout

@using AselDevBlazor.Application.Common.Interfaces.AuthServices
@using AselDevBlazor.Application.Features.Auth.DTOs
@using AselDevBlazor.Infrastructure.Auth
@using Microsoft.AspNetCore.Authorization

@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject JwtAuthStateProvider AuthStateProvider

<PageTitle>Sign In</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="login-container">

    <!-- Back Button -->
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Outlined.ArrowBack"
               OnClick="@(() => NavManager.NavigateTo("/"))">
        Back to Home
    </MudButton>

    <MudPaper Class="pa-6 mt-4" Elevation="1">

        <!-- Header -->
        <MudStack Spacing="1" Class="mb-4">
            <MudText Typo="Typo.h5">Sign in</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Enter your credentials to continue
            </MudText>
        </MudStack>

        <!-- Form -->
        <MudForm @ref="_form" @bind-IsValid="_isValid">

            <MudStack Spacing="2">

                <MudTextField @bind-Value="_model.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              Required="true"
                              FullWidth="true" />

                <MudTextField @bind-Value="_model.Password"
                              Label="Password"
                              Variant="Variant.Outlined"
                              InputType="@_passwordInputType"
                              Required="true"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordIcon"
                              OnAdornmentClick="TogglePassword"
                              FullWidth="true" />

                @if (_errorMessage is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @_errorMessage
                    </MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="HandleLoginAsync"
                           Disabled="@_loading">

                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <MudText>Signing in...</MudText>
                    }
                    else
                    {
                        <MudText>Sign In</MudText>
                      
                    }                  
                </MudButton>

            </MudStack>

        </MudForm>

        <!-- Footer -->
        <MudStack Direction="Row" Justify="Justify.Center" Class="mt-4">
            <MudText Typo="Typo.body2">
                Don't have an account?
            </MudText>

            <MudLink Href="/register" Class="ml-1">
                Create account
            </MudLink>
        </MudStack>

    </MudPaper>

</MudContainer>

<style>
    .login-container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginDto _model = new();
    private MudForm _form = default!;
    private bool _isValid = false;
    private bool _loading = false;
    private string? _errorMessage;

    private bool _showPassword = false;
    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string _passwordIcon => _showPassword
        ? Icons.Material.Outlined.VisibilityOff
        : Icons.Material.Outlined.Visibility;

    private void TogglePassword() => _showPassword = !_showPassword;

    private async Task HandleLoginAsync()
    {
        await _form.Validate();
        if (!_isValid) return;

        _loading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_model);

            if (response.Success && response.Data is not null)
            {
                await AuthStateProvider.SetTokenAsync(response.Data.Token);

                Snackbar.Add($"Welcome back, {response.Data.FullName}!", Severity.Success);

                var redirect = string.IsNullOrWhiteSpace(ReturnUrl)
                    ? "/"
                    : ReturnUrl;

                NavManager.NavigateTo(redirect, true);
            }
            else
            {
                _errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}