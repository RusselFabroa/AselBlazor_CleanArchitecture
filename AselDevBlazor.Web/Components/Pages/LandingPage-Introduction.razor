

<PageTitle>AselDev — Enterprise Blazor Architecture</PageTitle>

@* ══════════════════════════════════════════════
   HERO
   ══════════════════════════════════════════════ *@
<div class="home-hero">

    @* Background grid *@
    <div class="home-hero-grid" aria-hidden="true"></div>

    @* Glow blobs *@
    <div class="home-blob home-blob--1" aria-hidden="true"></div>
    <div class="home-blob home-blob--2" aria-hidden="true"></div>

    <div class="home-hero-inner">

        @* Status pill *@
        <div class="home-status-pill">
            <span class="home-status-dot"></span>
            In Active Development
        </div>

        @* Headline *@
        <h1 class="home-headline">
            AselDev Blazor Clean Architecture<br />
            <span class="home-headline-accent">Built for Scale</span>
        </h1>

        <p class="home-subheadline">
            A production-grade <strong>Blazor .NET</strong> application structured around
            Clean Architecture principles — separation of concerns, testability,
            and enterprise-ready patterns from day one.
        </p>

        @* CTA row *@
        <div class="home-cta-row">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Outlined.RocketLaunch"
                       Class="home-btn-primary"
                       Href="/dashboard">
                Explore Dashboard
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Outlined.Info"
                       Class="home-btn-ghost">
                Learn More
            </MudButton>
        </div>

        @* Stack badges *@
        <div class="home-stack-row">
            <span class="home-stack-label">Built with</span>
            @foreach (var tech in _techStack)
            {
                <div class="home-stack-badge">
                    <MudIcon Icon="@tech.Icon" Size="Size.Small" Class="home-stack-icon" />
                    @tech.Name
                </div>
            }
        </div>

    </div>

    @* Architecture diagram card *@
    <div class="home-arch-card">
        <div class="home-arch-card-header">
            <div class="home-arch-dot home-arch-dot--red"></div>
            <div class="home-arch-dot home-arch-dot--yellow"></div>
            <div class="home-arch-dot home-arch-dot--green"></div>
            <span class="home-arch-card-title">Solution Structure</span>
        </div>
        <div class="home-arch-card-body">
            @foreach (var layer in _layers)
            {
                <div class="home-arch-layer @layer.Class" style="animation-delay: @(layer.Delay)ms">
                    <div class="home-arch-layer-icon">
                        <MudIcon Icon="@layer.Icon" Size="Size.Small" />
                    </div>
                    <div class="home-arch-layer-info">
                        <span class="home-arch-layer-name">@layer.Name</span>
                        <span class="home-arch-layer-desc">@layer.Description</span>
                    </div>
                    <div class="home-arch-layer-badge">@layer.Badge</div>
                </div>
            }
        </div>
    </div>

</div>

@* ══════════════════════════════════════════════
   FEATURES GRID
   ══════════════════════════════════════════════ *@
<div class="home-section">

    <div class="home-section-header">
        <span class="home-section-eyebrow">What's Inside</span>
        <h2 class="home-section-title">Enterprise-Grade Foundation</h2>
        <p class="home-section-sub">
            Every layer is intentionally designed with clear boundaries,
            making the codebase easy to maintain, test, and extend.
        </p>
    </div>

    <div class="home-features-grid">
        @foreach (var (feature, i) in _features.Select((f, i) => (f, i)))
        {
            <div class="home-feature-card" style="animation-delay: @(i * 80)ms">
                <div class="home-feature-icon-wrap" style="--fc: @feature.Color;">
                    <MudIcon Icon="@feature.Icon" Class="home-feature-icon" />
                </div>
                <h3 class="home-feature-title">@feature.Title</h3>
                <p class="home-feature-desc">@feature.Description</p>
                @if (feature.Tags.Any())
                {
                    <div class="home-feature-tags">
                        @foreach (var tag in feature.Tags)
                        {
                            <span class="home-feature-tag">@tag</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

</div>

@* ══════════════════════════════════════════════
   LAYER BREAKDOWN
   ══════════════════════════════════════════════ *@
<div class="home-section home-section--alt">

    <div class="home-section-header">
        <span class="home-section-eyebrow">Architecture</span>
        <h2 class="home-section-title">Four Clean Layers</h2>
        <p class="home-section-sub">
            Each project has a single responsibility — dependencies always
            point inward, never outward.
        </p>
    </div>

    <div class="home-layers-list">
        @foreach (var (layer, i) in _detailedLayers.Select((l, i) => (l, i)))
        {
            <div class="home-layer-row" style="animation-delay: @(i * 100)ms">
                <div class="home-layer-number">0@(i + 1)</div>
                <div class="home-layer-content">
                    <div class="home-layer-top">
                        <h3 class="home-layer-name">@layer.Name</h3>
                        <span class="home-layer-chip" style="--lc: @layer.Color;">@layer.Tag</span>
                    </div>
                    <p class="home-layer-desc">@layer.Description</p>
                    <div class="home-layer-items">
                        @foreach (var item in layer.Items)
                        {
                            <span class="home-layer-item">
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Style="font-size:13px;" />
                                @item
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

</div>

@* ══════════════════════════════════════════════
   COMING SOON BANNER
   ══════════════════════════════════════════════ *@
<div class="home-section">
    <div class="home-coming-banner">
        <div class="home-coming-icon">
            <MudIcon Icon="@Icons.Material.Outlined.Construction" />
        </div>
        <div class="home-coming-text">
            <h3 class="home-coming-title">More Features Coming Soon</h3>
            <p class="home-coming-desc">
                This is the initial version. Full feature modules, dashboards,
                reports, and user management are actively being built.
            </p>
        </div>
        <div class="home-coming-pills">
            @foreach (var item in _upcoming)
            {
                <span class="home-coming-pill">@item</span>
            }
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════
   FOOTER NOTE
   ══════════════════════════════════════════════ *@
<div class="home-footer-note">
    <MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" Style="font-size:15px; color:var(--asel-accent);" />
    Crafted with <strong>C# · Blazor · .NET 8</strong> &nbsp;—&nbsp; AselDev Enterprise &copy; @DateTime.Now.Year
</div>

@* ══════════════════════════════════════════════
   STYLES
   ══════════════════════════════════════════════ *@
<style>
    /* ── Shared section ── */
    .home-section {
        padding: 56px 0 40px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .home-section--alt {
        background: linear-gradient(135deg, #F0F7FF 0%, #F8FAFC 100%);
        border-radius: 20px;
        padding: 48px 40px;
        margin-bottom: 16px;
    }

    .home-section-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .home-section-eyebrow {
        display: inline-block;
        font-family: var(--font-body);
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--asel-accent);
        background: var(--asel-accent-soft);
        border: 1px solid rgba(59,130,246,0.2);
        border-radius: 99px;
        padding: 4px 14px;
        margin-bottom: 14px;
    }

    .home-section-title {
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: var(--asel-text-primary);
        margin: 0 0 12px;
        letter-spacing: -0.5px;
    }

    .home-section-sub {
        font-size: 15px;
        color: var(--asel-text-secondary);
        max-width: 520px;
        margin: 0 auto;
        line-height: 1.65;
    }

    /* ══════════════════════════════════════════
           HERO
           ══════════════════════════════════════════ */
    .home-hero {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 48px;
        align-items: center;
        padding: 56px 0 48px;
        max-width: 1100px;
        margin: 0 auto;
        overflow: hidden;
        padding:5px;
    }

    /* Background dot grid */
    .home-hero-grid {
        position: absolute;
        inset: -40px;
        background-image: radial-gradient(circle, rgba(148,163,184,0.25) 1px, transparent 1px);
        background-size: 28px 28px;
        z-index: 0;
        mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);
    }

    /* Glow blobs */
    .home-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        z-index: 0;
        pointer-events: none;
    }

    .home-blob--1 {
        width: 400px;
        height: 400px;
        background: rgba(59,130,246,0.10);
        top: -100px;
        left: -80px;
    }

    .home-blob--2 {
        width: 300px;
        height: 300px;
        background: rgba(99,102,241,0.08);
        bottom: -60px;
        right: 60px;
    }

    .home-hero-inner {
        position: relative;
        z-index: 1;
    }

    /* Status pill */
    .home-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 600;
        color: #059669;
        background: rgba(5,150,105,0.08);
        border: 1px solid rgba(5,150,105,0.20);
        border-radius: 99px;
        padding: 5px 14px;
        margin-bottom: 22px;
        letter-spacing: 0.02em;
        animation: heroFadeUp 0.5s 0.1s both;
    }

    .home-status-dot {
        width: 7px;
        height: 7px;
        background: #10B981;
        border-radius: 50%;
        animation: statusPulse 2s ease-in-out infinite;
    }

    @@keyframes statusPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(16,185,129,0.4);
        }

        50% {
            box-shadow: 0 0 0 5px rgba(16,185,129,0.0);
        }
    }

    /* Headline */
    .home-headline {
        font-family: var(--font-display);
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 700;
        color: var(--asel-text-primary);
        line-height: 1.15;
        letter-spacing: -1px;
        margin: 0 0 18px;
        animation: heroFadeUp 0.5s 0.15s both;
    }

    .home-headline-accent {
        background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .home-subheadline {
        font-size: 15.5px;
        color: var(--asel-text-secondary);
        line-height: 1.7;
        max-width: 480px;
        margin-bottom: 30px;
        animation: heroFadeUp 0.5s 0.2s both;
    }

        .home-subheadline strong {
            color: var(--asel-text-primary);
            font-weight: 600;
        }

    /* CTA row */
    .home-cta-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 32px;
        flex-wrap: wrap;
        animation: heroFadeUp 0.5s 0.25s both;
    }

    .home-btn-primary {
        border-radius: 10px !important;
        padding: 10px 24px !important;
        font-family: var(--font-display) !important;
        font-weight: 600 !important;
        box-shadow: 0 4px 14px rgba(59,130,246,0.30) !important;
        transition: var(--asel-transition) !important;
    }

        .home-btn-primary:hover {
            box-shadow: 0 6px 20px rgba(59,130,246,0.45) !important;
            transform: translateY(-1px);
        }

    .home-btn-ghost {
        border-radius: 10px !important;
        border-color: var(--asel-border) !important;
        color: var(--asel-text-secondary) !important;
        font-family: var(--font-display) !important;
        font-weight: 600 !important;
        transition: var(--asel-transition) !important;
    }

        .home-btn-ghost:hover {
            border-color: var(--asel-accent) !important;
            color: var(--asel-accent) !important;
            background: var(--asel-accent-soft) !important;
        }

    /* Stack badges */
    .home-stack-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        animation: heroFadeUp 0.5s 0.30s both;
    }

    .home-stack-label {
        font-size: 12px;
        color: var(--asel-text-muted);
        font-weight: 500;
        margin-right: 2px;
    }

    .home-stack-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 600;
        color: var(--asel-text-secondary);
        background: #FFFFFF;
        border: 1px solid var(--asel-border);
        border-radius: 7px;
        padding: 4px 10px;
        box-shadow: var(--asel-shadow-sm);
        transition: var(--asel-transition);
    }

        .home-stack-badge:hover {
            border-color: var(--asel-accent);
            color: var(--asel-accent);
        }

    .home-stack-icon {
        font-size: 15px !important;
        color: var(--asel-accent) !important;
    }

    /* ── Architecture card ── */
    .home-arch-card {
        position: relative;
        z-index: 1;
        background: #FFFFFF;
        border: 1px solid var(--asel-border);
        border-radius: 16px;
        box-shadow: var(--asel-shadow-lg);
        overflow: hidden;
        animation: heroFadeUp 0.5s 0.2s both;
    }

    .home-arch-card-header {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 12px 16px;
        background: #F8FAFC;
        border-bottom: 1px solid var(--asel-border);
    }

    .home-arch-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
    }

    .home-arch-dot--red {
        background: #FF5F57;
    }

    .home-arch-dot--yellow {
        background: #FEBC2E;
    }

    .home-arch-dot--green {
        background: #28C840;
    }

    .home-arch-card-title {
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: var(--asel-text-muted);
        margin-left: 4px;
    }

    .home-arch-card-body {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .home-arch-layer {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 10px;
        border: 1px solid var(--asel-border);
        background: #FAFAFA;
        transition: var(--asel-transition);
        animation: heroFadeUp 0.4s both;
    }

        .home-arch-layer:hover {
            border-color: var(--asel-accent);
            background: var(--asel-accent-soft);
            transform: translateX(3px);
        }

    .home-arch-layer--web {
        --lc: #3B82F6;
    }

    .home-arch-layer--app {
        --lc: #8B5CF6;
    }

    .home-arch-layer--infra {
        --lc: #F59E0B;
    }

    .home-arch-layer--domain {
        --lc: #10B981;
    }

    .home-arch-layer-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(var(--lc), 0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--lc) !important;
    }

        .home-arch-layer-icon .mud-icon-root {
            color: var(--lc) !important;
            font-size: 17px !important;
        }

    .home-arch-layer-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        line-height: 1;
        min-width: 0;
    }

    .home-arch-layer-name {
        font-family: var(--font-display);
        font-size: 13px;
        font-weight: 600;
        color: var(--asel-text-primary);
        margin-bottom: 2px;
    }

    .home-arch-layer-desc {
        font-size: 11px;
        color: var(--asel-text-muted);
    }

    .home-arch-layer-badge {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 600;
        color: var(--asel-text-muted);
        background: #F1F5F9;
        border: 1px solid var(--asel-border);
        border-radius: 5px;
        padding: 2px 7px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    /* ══════════════════════════════════════════
           FEATURES GRID
           ══════════════════════════════════════════ */
    .home-features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 18px;
    }

    .home-feature-card {
        background: #FFFFFF;
        border: 1px solid var(--asel-border);
        border-radius: 14px;
        padding: 24px;
        transition: var(--asel-transition);
        animation: heroFadeUp 0.5s both;
    }

        .home-feature-card:hover {
            border-color: var(--asel-accent);
            box-shadow: var(--asel-shadow-md);
            transform: translateY(-2px);
        }

    .home-feature-icon-wrap {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: color-mix(in srgb, var(--fc) 12%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .home-feature-icon {
        color: var(--fc) !important;
        font-size: 22px !important;
    }

    .home-feature-title {
        font-family: var(--font-display);
        font-size: 15px;
        font-weight: 700;
        color: var(--asel-text-primary);
        margin: 0 0 8px;
        letter-spacing: -0.2px;
    }

    .home-feature-desc {
        font-size: 13.5px;
        color: var(--asel-text-secondary);
        line-height: 1.6;
        margin: 0 0 14px;
    }

    .home-feature-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .home-feature-tag {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--asel-text-secondary);
        background: #F1F5F9;
        border: 1px solid var(--asel-border);
        border-radius: 5px;
        padding: 2px 8px;
    }

    /* ══════════════════════════════════════════
           LAYER BREAKDOWN
           ══════════════════════════════════════════ */
    .home-layers-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .home-layer-row {
        display: flex;
        align-items: flex-start;
        gap: 24px;
        padding: 24px;
        background: #FFFFFF;
        border: 1px solid var(--asel-border);
        border-radius: 14px;
        transition: var(--asel-transition);
        animation: heroFadeUp 0.5s both;
    }

        .home-layer-row:hover {
            border-color: var(--asel-accent);
            box-shadow: var(--asel-shadow-sm);
        }

    .home-layer-number {
        font-family: var(--font-mono);
        font-size: 28px;
        font-weight: 700;
        color: var(--asel-border);
        line-height: 1;
        flex-shrink: 0;
        letter-spacing: -1px;
        padding-top: 2px;
    }

    .home-layer-content {
        flex: 1;
        min-width: 0;
    }

    .home-layer-top {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        flex-wrap: wrap;
    }

    .home-layer-name {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 700;
        color: var(--asel-text-primary);
        margin: 0;
    }

    .home-layer-chip {
        font-family: var(--font-mono);
        font-size: 10.5px;
        font-weight: 600;
        color: var(--lc);
        background: color-mix(in srgb, var(--lc) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--lc) 25%, transparent);
        border-radius: 99px;
        padding: 3px 10px;
    }

    .home-layer-desc {
        font-size: 13.5px;
        color: var(--asel-text-secondary);
        line-height: 1.65;
        margin: 0 0 12px;
    }

    .home-layer-items {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .home-layer-item {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        color: var(--asel-text-secondary);
        background: #F8FAFC;
        border: 1px solid var(--asel-border);
        border-radius: 6px;
        padding: 3px 9px;
    }

    /* ══════════════════════════════════════════
           COMING SOON
           ══════════════════════════════════════════ */
    .home-coming-banner {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 28px 32px;
        background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
        border-radius: 16px;
        flex-wrap: wrap;
    }

    .home-coming-icon {
        width: 52px;
        height: 52px;
        background: rgba(59,130,246,0.15);
        border: 1px solid rgba(59,130,246,0.25);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .home-coming-icon .mud-icon-root {
            color: #60A5FA !important;
            font-size: 26px !important;
        }

    .home-coming-text {
        flex: 1;
        min-width: 180px;
    }

    .home-coming-title {
        font-family: var(--font-display);
        font-size: 17px;
        font-weight: 700;
        color: #F8FAFC;
        margin: 0 0 6px;
    }

    .home-coming-desc {
        font-size: 13.5px;
        color: #94A3B8;
        line-height: 1.6;
        margin: 0;
    }

    .home-coming-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .home-coming-pill {
        font-size: 11.5px;
        font-weight: 600;
        color: #CBD5E1;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 99px;
        padding: 5px 13px;
        white-space: nowrap;
    }

    /* ══════════════════════════════════════════
