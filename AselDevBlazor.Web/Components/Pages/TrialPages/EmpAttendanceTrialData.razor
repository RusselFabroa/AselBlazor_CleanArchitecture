@page "/trial-data"

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IEmpAttendanceService AttendanceService
@inject IAuthGuardService _AuthGuard

@using AselDevBlazor.Application.Common.Interfaces.AuthServices
@using AselDevBlazor.Domain.Entities
@using AselDevBlazor.Application.Common.Interfaces

<PageTitle>Attendance</PageTitle>

<!-- HEADER -->
<MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">

    <MudStack Spacing="0">
        <MudText Typo="Typo.h5">Attendance</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Manage employee attendance records
        </MudText>
    </MudStack>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.Add"
               OnClick="OpenAddDialog">
        Add Record
    </MudButton>

</MudStack>

<!-- STATS -->
<MudGrid Class="mb-4">

    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.caption">Total</MudText>
            <MudText Typo="Typo.h6">@_records.Count</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.caption">Time In</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success">
                @_records.Count(x => x.AttendanceType == 1)
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.caption">Time Out</MudText>
            <MudText Typo="Typo.h6" Color="Color.Error">
                @_records.Count(x => x.AttendanceType == 0)
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3">
            <MudText Typo="Typo.caption">Employees</MudText>
            <MudText Typo="Typo.h6">
                @_records.Select(x => x.EmpId).Distinct().Count()
            </MudText>
        </MudPaper>
    </MudItem>

</MudGrid>

<!-- TABLE -->
<MudPaper Class="pa-3">

    <MudDataGrid T="EmpAttendanceData"
                 Items="@_records"
                 Loading="@_loading"
                 RowsPerPage="15"
                 Dense="true">

        <ToolBarContent>

            <MudText Typo="Typo.h6">Records</MudText>

            <MudSpacer />

            <MudTextField @bind-Value="_searchString"
                          Placeholder="Search..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Style="max-width:240px" />

            <MudIconButton Icon="@Icons.Material.Outlined.Refresh"
                           OnClick="LoadDataAsync" />

        </ToolBarContent>

        <Columns>

            <PropertyColumn Property="x => x.Id" Title="ID" />

            <PropertyColumn Property="x => x.EmpId" Title="Employee">
                <CellTemplate>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudAvatar Size="Size.Small">
                            @context.Item.EmpId.Substring(0, Math.Min(2, context.Item.EmpId.Length)).ToUpper()
                        </MudAvatar>
                        <MudText Typo="Typo.body2">@context.Item.EmpId</MudText>
                    </MudStack>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.EmpName" Title="Name" />

            <PropertyColumn Property="x => x.EmpShift" Title="Shift">
                <CellTemplate>
                    <MudChip Size="Size.Small" Variant="Variant.Outlined">
                        @context.Item.EmpShift
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.Timestamp" Title="Timestamp">
                <CellTemplate>
                    @context.Item.Timestamp.ToString("MMM dd, yyyy HH:mm")
                </CellTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.AttendanceType" Title="Type">
                <CellTemplate>
                    <MudChip Size="Size.Small"
                             Color="@(context.Item.AttendanceType == 1 ? Color.Success : Color.Error)"
                             Icon="@(context.Item.AttendanceType == 1 ? Icons.Material.Outlined.Login : Icons.Material.Outlined.Logout)">
                        @(context.Item.AttendanceType == 1 ? "Time In" : "Time Out")
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>

            <TemplateColumn Title="Actions">
                <CellTemplate>
                    <MudStack Row>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => OpenEditDialog(context.Item))" />

                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmDelete(context.Item))" />
                    </MudStack>
                   
                </CellTemplate>
            </TemplateColumn>

        </Columns>

    </MudDataGrid>

</MudPaper>

<!-- DIALOG -->
<MudDialog @bind-Visible="_showDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_isEditMode ? "Edit Record" : "Add Record")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="_formRef" @bind-IsValid="_isValid">

            <MudStack Spacing="2">

                <MudTextField @bind-Value="_form.EmpId" Label="Employee ID" Required="true" />
                <MudTextField @bind-Value="_form.EmpName" Label="Name" Required="true" />
                <MudTextField @bind-Value="_form.EmpShift" Label="Shift" Required="true" />

                <MudSelect @bind-Value="_form.AttendanceType" Label="Type">
                    <MudSelectItem Value="1">Time In</MudSelectItem>
                    <MudSelectItem Value="0">Time Out</MudSelectItem>
                </MudSelect>

            </MudStack>

        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CloseDialog">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SaveAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<EmpAttendanceData> _records = new();
    private bool _loading;
    private string _searchString = "";

    private bool _showDialog;
    private bool _isEditMode;
    private bool _isValid;

    private MudForm _formRef = default!;

    private AttendanceForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        await _AuthGuard.EnsureAuthorizedAsync(new() { "Admin", "Manager" });
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;

        var result = await AttendanceService.GetAllAsync();
        _records = result.Data.OrderByDescending(x => x.Timestamp).ToList();

        _loading = false;
    }

    private void OpenAddDialog()
    {
        _isEditMode = false;
        _form = new();
        _showDialog = true;
    }

    private void OpenEditDialog(EmpAttendanceData item)
    {
        _isEditMode = true;

        _form = new()
        {
            Id = item.Id,
            EmpId = item.EmpId,
            EmpName = item.EmpName,
            EmpShift = item.EmpShift,
            AttendanceType = item.AttendanceType
        };

        _showDialog = true;
    }

    private void CloseDialog()
    {
        _showDialog = false;
    }

    private async Task SaveAsync()
    {
        await _formRef.Validate();
        if (!_isValid) return;

        if (_isEditMode)
        {
            await AttendanceService.UpdateAsync(_form.Id, new EmpAttendanceData
            {
                EmpId = _form.EmpId,
                EmpName = _form.EmpName,
                EmpShift = _form.EmpShift,
                AttendanceType = _form.AttendanceType
            });
        }
        else
        {
            await AttendanceService.CreateAsync(new EmpAttendanceData
            {
                EmpId = _form.EmpId,
                EmpName = _form.EmpName,
                EmpShift = _form.EmpShift,
                AttendanceType = _form.AttendanceType
            });
        }

        Snackbar.Add("Saved successfully", Severity.Success);

        _showDialog = false;
        await LoadDataAsync();
    }

    private async Task ConfirmDelete(EmpAttendanceData item)
    {
        await AttendanceService.DeleteAsync(item.Id);
        Snackbar.Add("Deleted successfully", Severity.Success);
        await LoadDataAsync();
    }

    private class AttendanceForm
    {
        public int Id { get; set; }
        public string EmpId { get; set; } = "";
        public string EmpName { get; set; } = "";
        public string EmpShift { get; set; } = "";
        public byte AttendanceType { get; set; }
    }
}