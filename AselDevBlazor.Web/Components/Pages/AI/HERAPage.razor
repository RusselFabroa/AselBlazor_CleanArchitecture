@page "/agent/hera"
@using AselDevBlazor.Application.Common.Interfaces.AI
@using AselDevBlazor.Domain.Entities.AIModels.Ollama
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Web
@inject IOllamaService OllamaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>HERA — AI HR Assistant</PageTitle>

<div class="hera-root">

    <div class="hera-header">
        <div class="hera-header-main">
            <div class="hera-brand">
                <div class="hera-brand-mark">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" />
                </div>
                <div class="hera-brand-copy">
                    <MudText Typo="Typo.subtitle1" Class="hera-brand-title">HERA</MudText>
                    <MudText Typo="Typo.caption" Class="hera-brand-subtitle">AI-powered Human Resource Assistant</MudText>
                </div>
            </div>

            <div class="hera-header-actions">
                <button class="ghost-action" @onclick="RefreshOnlineStatus" disabled="@_isRefreshingStatus">
                    @if (_isRefreshingStatus)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ghost-action-spinner" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Refresh" />
                    }
                    <span>Refresh status</span>
                </button>

                @if (_turns.Any())
                {
                    <button class="ghost-action" @onclick="ClearHistory">
                        <MudIcon Icon="@Icons.Material.Outlined.DeleteSweep" />
                        <span>Clear</span>
                    </button>
                }
            </div>
        </div>

        <div class="hera-summary-row">
            <div class="summary-pill @(_isOnline ? "summary-pill-online" : "summary-pill-offline")">
                <span class="summary-dot"></span>
                <span>@(_isOnline ? "DX server online" : "DX server offline")</span>
            </div>
            <div class="summary-pill">
                <MudIcon Icon="@Icons.Material.Outlined.Psychology" />
                <span>Model: @_activeModel</span>
            </div>
            <div class="summary-pill">
                <MudIcon Icon="@Icons.Material.Outlined.Forum" />
                <span>@_intentHistory.Count turn@(_intentHistory.Count != 1 ? "s" : "")</span>
            </div>
            <div class="summary-pill">
                <MudIcon Icon="@Icons.Material.Outlined.Bolt" />
                <span>Intent-first HR workflow</span>
            </div>
        </div>
    </div>

    <div class="hera-chat @(!_turns.Any() && !_isDetecting ? "hera-chat-empty" : "")" id="chat-area">

        @if (!_turns.Any() && !_isDetecting)
        {
            <div class="welcome-wrap">
                <div class="welcome-hero">
                    <div class="welcome-avatar">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="color:white; font-size:36px;" />
                    </div>
                    <div class="welcome-copy">
                        <MudText Typo="Typo.h4" Class="welcome-title">Hi, I'm HERA</MudText>
                        <MudText Typo="Typo.body1" Class="welcome-subtitle">
                            Ask about employee records, attendance, leave balances, manhours, or broader HR policy questions.
                        </MudText>
                    </div>
                </div>

                <div class="welcome-panel">
                    <div class="capability-grid">
                        @foreach (var capability in _capabilities)
                        {
                            <div class="capability-card">
                                <div class="capability-icon">
                                    <MudIcon Icon="@capability.Icon" />
                                </div>
                                <div class="capability-content">
                                    <div class="capability-title">@capability.Title</div>
                                    <div class="capability-text">@capability.Description</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="section-head">
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="section-title">Quick prompts</MudText>
                        <MudText Typo="Typo.caption" Class="section-caption">Pick a ready-made HR question or type your own below.</MudText>
                    </div>
                </div>

                <div class="suggestion-grid">
                    @foreach (var s in _suggestions)
                    {
                        <button class="suggestion-card" @onclick="@(() => UseSuggestion(s))">
                            <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
                            <span>@s</span>
                        </button>
                    }
                </div>
            </div>
        }

        @foreach (var turn in _turns)
        {
            <div class="msg-row user anim-in">
                <div class="avatar avatar-user">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:18px;" />
                </div>
                <div class="message-stack">
                    <div class="message-meta user-meta">You</div>
                    <div class="bubble bubble-user">@turn.UserMessage</div>
                </div>
            </div>

            @if (turn.Phase >= TurnPhase.IntentDetected && turn.Intent is not null)
            {
                <div class="msg-row anim-in">
                    <div class="avatar avatar-bot">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="font-size:18px;" />
                    </div>
                    <div class="message-stack assistant-stack">
                        <MudText Typo="Typo.caption" Class="message-meta assistant-meta">
                            HERA · @_activeModel · Intent detected
                        </MudText>

                        @if (turn.Intent.NeedsClarification)
                        {
                            <div class="clarify-bubble anim-in">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="clarify-head">
                                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:15px; color:#EF9F27;" />
                                    <MudText Typo="Typo.caption" Class="clarify-title">Clarification needed</MudText>
                                </MudStack>
                                @turn.Intent.ClarificationQuestion
                            </div>
                        }
                        else
                        {
                            <div class="intent-card anim-in">
                                <div class="intent-header">
                                    <div class="@($"intent-dot {GetIntentDotClass(turn.Intent.PrimaryIntent)}")"></div>
                                    <span class="intent-badge @GetIntentBadgeClass(turn.Intent.PrimaryIntent)">
                                        @GetIntentLabel(turn.Intent.PrimaryIntent)
                                    </span>
                                    <MudText Typo="Typo.caption" Class="intent-caption">
                                        Intent classified
                                    </MudText>
                                </div>
                                <div class="intent-body">
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.EmployeeId))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Employee ID</span>
                                            <span class="param-val">@turn.Intent.Parameters.EmployeeId</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.EmployeeName))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Employee name</span>
                                            <span class="param-val">@turn.Intent.Parameters.EmployeeName</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.Department))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Department</span>
                                            <span class="param-val">@turn.Intent.Parameters.Department</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.DateFrom))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Date from</span>
                                            <span class="param-val">@turn.Intent.Parameters.DateFrom</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.DateTo))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Date to</span>
                                            <span class="param-val">@turn.Intent.Parameters.DateTo</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(turn.Intent.Parameters.Keyword))
                                    {
                                        <div class="param-row">
                                            <span class="param-key">Keyword</span>
                                            <span class="param-val">@turn.Intent.Parameters.Keyword</span>
                                        </div>
                                    }
                                    @if (!HasAnyParam(turn.Intent.Parameters))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-style:italic; font-size:11px;">
                                            No parameters required for this intent
                                        </MudText>
                                    }
                                </div>
                            </div>

                            @if (turn.Phase == TurnPhase.LoadingData)
                            {
                                <div class="data-section anim-in">
                                    <div class="data-loading">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                                             Style="width:14px; height:14px;" Color="Color.Primary" />
                                        <span>Fetching data from system...</span>
                                    </div>
                                </div>
                            }
                            else if (turn.Phase == TurnPhase.Complete && !string.IsNullOrEmpty(turn.SystemResult))
                            {
                                <div class="data-section anim-in @GetDataSectionClass(turn.Intent.PrimaryIntent)">
                                    <MudText Typo="Typo.caption" Class="data-section-title">
                                        System result
                                    </MudText>
                                    <MudText Typo="Typo.body2" Style="line-height:1.65; white-space:pre-wrap;">
                                        @turn.SystemResult
                                    </MudText>
                                </div>
                            }
                            else if (turn.Phase == TurnPhase.Error && !string.IsNullOrEmpty(turn.SystemResult))
                            {
                                <div class="data-section data-section-error anim-in">
                                    <MudText Typo="Typo.caption" Class="data-section-title error-title">
                                        Request failed
                                    </MudText>
                                    <MudText Typo="Typo.body2" Style="line-height:1.65; white-space:pre-wrap;">
                                        @turn.SystemResult
                                    </MudText>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }

        @if (_isDetecting)
        {
            <div class="msg-row anim-in">
                <div class="avatar avatar-bot">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="font-size:18px;" />
                </div>
                <div class="message-stack assistant-stack">
                    <MudText Typo="Typo.caption" Class="message-meta assistant-meta">
                        HERA · Analyzing intent...
                    </MudText>
                    <div class="bubble bubble-bot bubble-loading">
                        <div class="typing-dots">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="hera-footer">
        <div class="footer-shell">
            <div class="input-box">
                <textarea placeholder="Ask about attendance, leave, employee info, manhours..."
                          rows="1"
                          disabled="@(_isDetecting)"
                          @bind="_userInput"
                          @bind:event="oninput"
                          @onkeydown="OnKeyDown"
                          style="@(_isDetecting ? "opacity:0.5;" : "")">
                </textarea>
                <button class="send-btn"
                        @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_userInput) || _isDetecting)">
                    @if (_isDetecting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Style="width:16px; height:16px; color:white;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Style="font-size:18px;" />
                    }
                </button>
            </div>
            <div class="footer-meta">
                <span>HERA runs locally on your DX server</span>
                <span>Shift+Enter for new line</span>
                <span>@_intentHistory.Count turn@(_intentHistory.Count != 1 ? "s" : "") in context</span>
            </div>
        </div>
    </div>

</div>


@code {

    // ── System Prompt ─────────────────────────────────────────────────────────

    private const string SystemPrompt = @"
You are an intent classifier for an HR Attendance Management System.
Analyze the user message AND the conversation history to understand the full context.

IMPORTANT CONTEXT RULES:
- If the user refers to 'him', 'her', 'his', 'their', 'that employee', 'the same person'
  — look back at the conversation history to find who they are referring to
- If the user gives a short follow-up like 'Department', 'Leave balance', 'His ID'
  — treat it as a continuation of the previous question
- If an employee ID or name was mentioned earlier in the conversation,
  carry it forward into the current parameters if still relevant
- Never treat a follow-up message as unrelated just because it is short

Available intents:
- attendance   → attendance logs, absences, tardiness, overtime, attendance records, attendance, time in/out, shift schedule, present, absent, late, early, no-show
- leave        → leave balance, leave filing, leave status
- ehr          → employee details, profile, department, position
- manhour      → working hours, total hours rendered
- general_hr   → HR related but no specific data needed
- unknown      → not HR related at all

Parameter extraction rules:
- Extract EmployeeId if a code or ID number is mentioned (current or from history)
- Extract EmployeeName if a person's name is mentioned (current or from history)
- Strip honorifics: Mr., Mrs., Ms., Sir, Ma'am, Dr., Kuya, Ate, -san, -kun
- EmployeeId and EmployeeName are mutually exclusive — extract only one
- Extract Department, DateFrom, DateTo if mentioned (YYYY-MM-DD format)
- 'today' → today's date, 'this week' → Monday to today, 'last week' → last Mon–Sun
- 'this month' → 1st to today, 'last month' → full previous month

Intent-specific rules:
- attendance → EmployeeId REQUIRED. If missing, NeedsClarification = true.
- ehr        → EmployeeId OR EmployeeName OR Department is enough.
- leave      → EmployeeId or EmployeeName is enough.
- manhour    → EmployeeId or Department is enough.
- general_hr → No parameters required. Never set NeedsClarification to true.

Respond ONLY in valid JSON, no explanation, no markdown:
{
  ""Intents"": [""ehr""],
  ""Parameters"": {
    ""EmployeeId"": null,
    ""EmployeeName"": null,
    ""Department"": null,
    ""DateFrom"": null,
    ""DateTo"": null,
    ""Keyword"": null
  },
  ""IsHRRelated"": true,
  ""NeedsClarification"": false,
  ""ClarificationQuestion"": null
}";

    // ── Suggestions ───────────────────────────────────────────────────────────

    private readonly List<string> _suggestions = new()
    {
        "Show attendance of 01026791 this month",
        "What is the leave balance of Juan dela Cruz?",
        "Show employee details of EMP-00123",
        "List all employees in IT department",
        "How many hours did 01026791 render last week?",
        "What is our tardiness policy?",
        "Show absences this month for Engineering dept",
        "Check leave filing status of Ms. Santos",
    };

    private readonly List<HeraCapability> _capabilities = new()
    {
        new("Attendance insights", "Track logs, tardiness, absences, and period-based attendance summaries.", Icons.Material.Outlined.AccessTime),
        new("Leave and approvals", "Review balances, filing status, and leave-related follow-up questions.", Icons.Material.Outlined.EventAvailable),
        new("Employee records", "Pull profile, department, and personnel context for HR support.", Icons.Material.Outlined.Badge),
        new("Manhour summaries", "Check rendered hours, schedules, and time-based productivity details.", Icons.Material.Outlined.Schedule)
    };

    // ── State ─────────────────────────────────────────────────────────────────

    private string _userInput = string.Empty;
    private string _activeModel = "qwen3:1.7b";
    private bool _isDetecting = false;
    private bool _isOnline = false;
    private bool _isRefreshingStatus = false;

    // Intent classifier history (user + assistant JSON turns)
    private List<OllamaChatMessage> _intentHistory = new();

    // UI turns
    private List<HeraTurn> _turns = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _isOnline = await OllamaService.IsAvailableAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_turns.Any() || _isDetecting)
            await JS.InvokeVoidAsync("eval",
                "var el=document.getElementById('chat-area'); if(el) el.scrollTop=el.scrollHeight;");
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task UseSuggestion(string text)
    {
        _userInput = text;
        await SendMessage();
    }

    private async Task RefreshOnlineStatus()
    {
        if (_isRefreshingStatus)
            return;

        _isRefreshingStatus = true;
        StateHasChanged();

        try
        {
            _isOnline = await OllamaService.IsAvailableAsync();
        }
        finally
        {
            _isRefreshingStatus = false;
            StateHasChanged();
        }
    }

    private async Task SendMessage()
    {
        var input = _userInput.Trim();
        if (string.IsNullOrWhiteSpace(input) || _isDetecting) return;

        _userInput = string.Empty;
        _isDetecting = true;

        // Add turn to UI immediately (user message visible, intent loading)
        var turn = new HeraTurn { UserMessage = input, Phase = TurnPhase.Detecting };
        _turns.Add(turn);
        StateHasChanged();

        try
        {
            // ── Phase 1: Intent Detection ─────────────────────────────────────
            var intentResponse = await OllamaService.ChatAsync(new OllamaChatRequest
            {
                Model = _activeModel,
                SystemMessage = SystemPrompt,
                ChatHistory = _intentHistory,
                UserMessage = input,
                Temperature = 0.1,
                TopK = 20,
                TopP = 0.95,
                RepeatPenalty = 1.0,
                NumPredict = 300,
                NumCtx = 4096,
                Think = false
            });

            if (!intentResponse.IsSuccess)
            {
                turn.Phase = TurnPhase.Error;
                turn.SystemResult = $"Intent detection failed: {intentResponse.ErrorMessage}";
                return;
            }

            // Parse JSON response
            var intent = ParseIntent(intentResponse.Reply);
            turn.Intent = intent;

            if (intent.NeedsClarification)
            {
                // Show clarification bubble — update history so context carries forward
                turn.Phase = TurnPhase.IntentDetected;
                _intentHistory = intentResponse.UpdatedHistory;
                return;
            }

            // Unknown intent — show card but don't call system
            if (intent.PrimaryIntent == "unknown")
            {
                turn.Phase = TurnPhase.Complete;
                turn.SystemResult = "This query is not related to HR. Please ask about attendance, leave, employee info, or manhours.";
                // Do NOT add unknown to history — keeps context clean
                return;
            }

            // Valid HR intent — add to history and proceed to Phase 2
            _intentHistory = intentResponse.UpdatedHistory;
            turn.Phase = TurnPhase.IntentDetected;
            StateHasChanged();

            // Small delay so user sees the intent card before data loads
            await Task.Delay(600);

            // ── Phase 2: Load System Data ─────────────────────────────────────
            turn.Phase = TurnPhase.LoadingData;
            StateHasChanged();

            // TODO: Replace this with your actual service call based on intent
            // e.g. var data = await AttendanceService.GetAsync(intent.Parameters);
            var systemData = await SimulateSystemDataAsync(intent);

            turn.SystemResult = systemData;
            turn.Phase = TurnPhase.Complete;
        }
        catch (Exception ex)
        {
            turn.Phase = TurnPhase.Error;
            turn.SystemResult = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            _isDetecting = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private void ClearHistory()
    {
        _intentHistory.Clear();
        _turns.Clear();
        StateHasChanged();
    }

    // ── TODO: Replace with your real service calls ────────────────────────────
    // This is a placeholder. Wire up your actual data services here.
    // The intent object gives you: intent.PrimaryIntent, intent.Parameters.*

    private static async Task<string> SimulateSystemDataAsync(HeraIntent intent)
    {
        await Task.Delay(1200); // simulate DB call

        return intent.PrimaryIntent switch
        {
            "attendance" => $"[Placeholder] Attendance data for Employee {intent.Parameters.EmployeeId ?? "N/A"}\n" +
                            $"Period: {intent.Parameters.DateFrom ?? "N/A"} → {intent.Parameters.DateTo ?? "N/A"}\n\n" +
                            "Wire up your AttendanceService here to return real records.",

            "leave" => $"[Placeholder] Leave data for {intent.Parameters.EmployeeName ?? intent.Parameters.EmployeeId ?? "N/A"}\n" +
                            "Wire up your LeaveService here to return real leave balance and history.",

            "ehr" => $"[Placeholder] Employee profile for {intent.Parameters.EmployeeName ?? intent.Parameters.EmployeeId ?? intent.Parameters.Department ?? "N/A"}\n" +
                            "Wire up your EhrService here to return real employee records.",

            "manhour" => $"[Placeholder] Manhour summary for {intent.Parameters.EmployeeId ?? intent.Parameters.Department ?? "N/A"}\n" +
                            "Wire up your ManhourService here to return real hour totals.",

            "general_hr" => "This is a general HR question. Wire up your HR knowledge base or AI summarizer here.",

            _ => "No data available for this intent."
        };
    }

    // ── Intent Parser ─────────────────────────────────────────────────────────

    private static HeraIntent ParseIntent(string raw)
    {
        try
        {
            var clean = raw.Trim();
            if (clean.StartsWith("```")) clean = clean.Replace("```json", "").Replace("```", "").Trim();

            using var doc = JsonDocument.Parse(clean);
            var root = doc.RootElement;

            var intents = root.TryGetProperty("Intents", out var iv)
                ? iv.EnumerateArray().Select(x => x.GetString() ?? "").ToList()
                : new List<string> { "unknown" };

            var p = root.TryGetProperty("Parameters", out var pv) ? pv : default;

            string? Get(string key) =>
                p.ValueKind != JsonValueKind.Undefined &&
                p.TryGetProperty(key, out var v) &&
                v.ValueKind == JsonValueKind.String
                    ? v.GetString()
                    : null;

            bool needsClarity = root.TryGetProperty("NeedsClarification", out var nc) && nc.GetBoolean();

            string? clarifyQ = root.TryGetProperty("ClarificationQuestion", out var cq) &&
                               cq.ValueKind == JsonValueKind.String
                ? cq.GetString() : null;

            return new HeraIntent
            {
                Intents = intents,
                NeedsClarification = needsClarity,
                ClarificationQuestion = clarifyQ,
                Parameters = new HeraParameters
                {
                    EmployeeId = Get("EmployeeId"),
                    EmployeeName = Get("EmployeeName"),
                    Department = Get("Department"),
                    DateFrom = Get("DateFrom"),
                    DateTo = Get("DateTo"),
                    Keyword = Get("Keyword"),
                }
            };
        }
        catch
        {
            return new HeraIntent { Intents = new() { "unknown" } };
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static bool HasAnyParam(HeraParameters p) =>
        !string.IsNullOrEmpty(p.EmployeeId) ||
        !string.IsNullOrEmpty(p.EmployeeName) ||
        !string.IsNullOrEmpty(p.Department) ||
        !string.IsNullOrEmpty(p.DateFrom) ||
        !string.IsNullOrEmpty(p.DateTo) ||
        !string.IsNullOrEmpty(p.Keyword);

    private static string GetIntentLabel(string intent) => intent switch
    {
        "attendance" => "Attendance",
        "leave" => "Leave",
        "ehr" => "Employee record",
        "manhour" => "Manhours",
        "general_hr" => "General HR",
        _ => "Unknown"
    };

    private static string GetIntentBadgeClass(string intent) => intent switch
    {
        "attendance" => "intent-attendance",
        "leave" => "intent-leave",
        "ehr" => "intent-ehr",
        "manhour" => "intent-manhour",
        "general_hr" => "intent-general",
        _ => "intent-unknown"
    };

    private static string GetIntentDotClass(string intent) => intent switch
    {
        "attendance" => "intent-dot-attendance",
        "leave" => "intent-dot-leave",
        "ehr" => "intent-dot-ehr",
        "manhour" => "intent-dot-manhour",
        "general_hr" => "intent-dot-general",
        _ => "intent-dot-unknown"
    };

    private static string GetDataSectionClass(string intent) => intent switch
    {
        "attendance" => "data-section-attendance",
        "leave" => "data-section-leave",
        "ehr" => "data-section-ehr",
        "manhour" => "data-section-manhour",
        "general_hr" => "data-section-general",
        _ => "data-section-unknown"
    };

    // ── Models ────────────────────────────────────────────────────────────────

    private enum TurnPhase { Detecting, IntentDetected, LoadingData, Complete, Error }

    private class HeraTurn
    {
        public string UserMessage { get; set; } = string.Empty;
        public TurnPhase Phase { get; set; } = TurnPhase.Detecting;
        public HeraIntent? Intent { get; set; }
        public string? SystemResult { get; set; }
    }

    private class HeraIntent
    {
        public List<string> Intents { get; set; } = new();
        public HeraParameters Parameters { get; set; } = new();
        public bool NeedsClarification { get; set; }
        public string? ClarificationQuestion { get; set; }
        public bool IsHRRelated { get; set; } = true;
        public string PrimaryIntent => Intents.FirstOrDefault() ?? "unknown";
    }

    private class HeraParameters
    {
        public string? EmployeeId { get; set; }
        public string? EmployeeName { get; set; }
        public string? Department { get; set; }
        public string? DateFrom { get; set; }
        public string? DateTo { get; set; }
        public string? Keyword { get; set; }
    }

    private record HeraCapability(string Title, string Description, string Icon);
}
