@page "/agent/power-platform"
@using AselDevBlazor.Application.Common.Interfaces.AI
@using AselDevBlazor.Domain.Entities.AIModels.Ollama
@inject IOllamaService OllamaService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>DX365 — M365 Power Platform Assistant</PageTitle>

<style>
    .dx365-root {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 64px);
        background: var(--mud-palette-background-grey);
    }
    .dx365-header {
        background: var(--mud-palette-surface);
        border-bottom: 1px solid #e0e0e0;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }
    .dx365-chat {
        flex: 1;
        overflow-y: auto;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 24px;
        scroll-behavior: smooth;
    }
    .dx365-footer {
        background: var(--mud-palette-background-grey);
        padding: 12px 1rem 16px;
        flex-shrink: 0;
    }
    .input-box {
        background: var(--mud-palette-surface);
        border: 1.5px solid #d0d0d0;
        border-radius: 14px;
        padding: 10px 12px 10px 16px;
        display: flex;
        align-items: flex-end;
        gap: 8px;
        transition: border-color .2s;
        max-width: 780px;
        margin: 0 auto;
    }
    .input-box:focus-within {
        border-color: #1F4E79;
    }
    .input-box textarea {
        flex: 1;
        border: none;
        outline: none;
        resize: none;
        background: transparent;
        font-size: 14px;
        line-height: 1.55;
        color: var(--mud-palette-text-primary);
        min-height: 24px;
        max-height: 140px;
        overflow-y: auto;
        font-family: inherit;
        padding: 2px 0;
    }
    .msg-row { display: flex; gap: 12px; max-width: 780px; margin: 0 auto; width: 100%; }
    .msg-row.user { flex-direction: row-reverse; }
    .avatar {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; font-weight: 500; flex-shrink: 0;
    }
    .avatar-bot  { background: #1F4E79; color: white; }
    .avatar-user { background: #e0e0e0; color: #444; }
    .bubble {
        padding: 10px 14px;
        border-radius: 2px 14px 14px 14px;
        font-size: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
        max-width: calc(100% - 46px);
    }
    .bubble-bot  { background: var(--mud-palette-surface); border: 0.5px solid #e0e0e0; color: var(--mud-palette-text-primary); }
    .bubble-user { background: #1F4E79; color: white; border-radius: 14px 2px 14px 14px; }
    .bubble-mono { font-family: monospace; font-size: 12px; }
    .send-btn {
        width: 34px; height: 34px; border-radius: 8px;
        background: #1F4E79; color: white; border: none;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; flex-shrink: 0; transition: opacity .15s;
    }
    .send-btn:disabled { opacity: 0.4; cursor: default; }
    .welcome-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; padding: 2rem 1rem; gap: 16px; }
    .welcome-avatar { width: 72px; height: 72px; border-radius: 18px; background: #1F4E79; display: flex; align-items: center; justify-content: center; }
    .suggestion-grid { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 600px; }
    .suggestion-chip {
        border: 0.5px solid #d0d0d0; border-radius: 99px;
        padding: 6px 14px; font-size: 12px; cursor: pointer;
        background: var(--mud-palette-surface); color: var(--mud-palette-text-secondary);
        transition: border-color .15s, color .15s;
    }
    .suggestion-chip:hover { border-color: #1F4E79; color: #1F4E79; }
    .model-select-wrap { display: flex; align-items: center; gap: 6px; padding: 0 4px 6px; }
    .model-pill {
        border: 0.5px solid #d0d0d0; border-radius: 6px; background: transparent;
        font-size: 11px; padding: 3px 8px; cursor: pointer; color: var(--mud-palette-text-secondary);
        display: flex; align-items: center; gap: 4px; font-family: inherit;
        transition: border-color .15s;
    }
    .model-pill:hover { border-color: #1F4E79; color: #1F4E79; }

    .typing-dots {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 4px 2px;
    }

    .typing-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #1F4E79;
        display: block;
        flex-shrink: 0;
        animation: bounce .9s infinite ease-in-out;
    }

        .typing-dot:nth-child(2) {
            animation-delay: .15s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: .30s;
        }
    @@keyframes bounce { 0%,60%,100% { transform:translateY(0); } 30% { transform:translateY(-5px); } }
</style>

<div class="dx365-root">

    @* ── Top Header ── *@
    <div class="dx365-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudPaper Width="36px" Height="36px"
                      Style="background:#1F4E79; border-radius:8px; display:flex; align-items:center; justify-content:center;"
                      Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Cloud" Style="color:white; font-size:20px;" />
            </MudPaper>
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:500; line-height:1.2;">DX365</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height:1.2;">
                    M365 Power Platform Assistant
                </MudText>
            </div>
        </MudStack>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (_messages.Any())
            {
                <MudTooltip Text="Clear conversation" Placement="Placement.Bottom">
                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   OnClick="ClearHistory" />
                </MudTooltip>
            }
            <MudChip T="string"
                     Icon="@(_isOnline ? Icons.Material.Filled.Circle : Icons.Material.Outlined.Circle)"
                     Color="@(_isOnline ? Color.Success : Color.Error)"
                     Variant="Variant.Filled"
                     Size="Size.Small"
                     Style="font-size:11px;">
                @(_isOnline ? "Online" : "Offline")
            </MudChip>
        </MudStack>
    </div>

    @* ── Chat Area ── *@
    <div class="dx365-chat" id="chat-area">

        @if (!_messages.Any())
        {
            @* Welcome Screen *@
            <div class="welcome-wrap">
                <div class="welcome-avatar">
                    <MudIcon Icon="@Icons.Material.Filled.Cloud" Style="color:white; font-size:36px;" />
                </div>
                <div style="text-align:center;">
                    <MudText Typo="Typo.h5" Style="font-weight:500; margin-bottom:4px;">Hi, I'm DX365</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="max-width:460px; line-height:1.6;">
                        Your Microsoft 365 Power Platform specialist. I can help you with
                        Power Apps, Power Automate, Power BI, Power Pages, and Dataverse —
                        from building flows to troubleshooting integrations.
                    </MudText>
                </div>

                @* Capability badges *@
                <MudStack Row="true" Spacing="1" Style="flex-wrap:wrap; justify-content:center;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="font-size:11px;" Icon="@Icons.Material.Filled.Apps">Power Apps</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="font-size:11px;" Icon="@Icons.Material.Filled.AutoMode">Power Automate</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="font-size:11px;" Icon="@Icons.Material.Filled.BarChart">Power BI</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="font-size:11px;" Icon="@Icons.Material.Filled.Language">Power Pages</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Style="font-size:11px;" Icon="@Icons.Material.Filled.Storage">Dataverse</MudChip>
                </MudStack>

                @* Suggestion chips *@
                <div class="suggestion-grid">
                    @foreach (var s in _suggestions)
                    {
                        <button class="suggestion-chip" @onclick="@(() => UseSuggestion(s))">@s</button>
                    }
                </div>
            </div>
        }
        else
        {
            @* Message list *@
            @foreach (var msg in _messages)
            {
                @if (msg.Role == "user")
                {
                    <div class="msg-row user">
                        <div class="avatar avatar-user">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:18px;" />
                        </div>
                        <div class="bubble bubble-user">@msg.Content</div>
                    </div>
                }
                else if (msg.Role == "assistant")
                {
                    <div class="msg-row">
                        <div class="avatar avatar-bot">
                            <MudIcon Icon="@Icons.Material.Filled.Cloud" Style="font-size:18px;" />
                        </div>
                        <div style="flex:1; max-width:calc(100% - 46px);">
                            <MudText Typo="Typo.caption" Style="color:#1F4E79; font-size:10px; font-weight:500; margin-bottom:4px; display:block;">
                                DX365 · @_activeModel
                            </MudText>
                            <div class="bubble bubble-bot @(IsJson(msg.Content) ? "bubble-mono" : "")">
                                @msg.Content
                            </div>
                        </div>
                    </div>
                }
                else if (msg.Role == "_error")
                {
                    <div style="max-width:780px; margin:0 auto; width:100%;">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                            @msg.Content
                        </MudAlert>
                    </div>
                }
                else if (msg.Role == "_info")
                {
                    <div style="text-align:center;">
                        <MudText Typo="Typo.caption" Color="Color.Tertiary" Style="font-size:10px;">
                            @msg.Content
                        </MudText>
                    </div>
                }
            }

            @* Typing indicator *@
            @if (_isLoading)
            {
                <div class="msg-row">
                    <div class="avatar avatar-bot">
                        <MudIcon Icon="@Icons.Material.Filled.Cloud" Style="font-size:18px;" />
                    </div>
                    <div class="bubble bubble-bot" style="padding:12px 16px;">
                        <div class="typing-dots">
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                            <span class="typing-dot"></span>
                        </div>
                    </div>
                </div>
            }
        }

    </div>

    @* ── Input Footer ── *@
    <div class="dx365-footer">
        <div style="max-width:780px; margin:0 auto;">

            @* Model selector row — above the input box *@
            <div class="model-select-wrap">
                <MudIcon Icon="@Icons.Material.Filled.Memory" Style="font-size:13px; opacity:0.45;" />
                <MudSelect @bind-Value="_activeModel"
                           Dense="true"
                           Margin="Margin.None"
                           Variant="Variant.Text"
                           Style="font-size:12px; min-width:160px; max-width:200px;"
                           Class="model-selector">
                    @foreach (var m in _availableModels)
                    {
                        <MudSelectItem Value="@m" Style="font-size:12px;">@m</MudSelectItem>
                    }
                </MudSelect>
            </div>

            @* Input box *@
            <div class="input-box">
                <textarea id="user-input"
                          placeholder="Ask about Power Apps, Power Automate, Power BI…"
                          rows="1"
                          disabled="@_isLoading"
                          @bind="_userInput"
                          @bind:event="oninput"
                          @onkeydown="OnKeyDown"
                          style="@(_isLoading ? "opacity:0.5;" : "")">
                </textarea>

                <button class="send-btn"
                        @onclick="SendMessage"
                        disabled="@(string.IsNullOrWhiteSpace(_userInput) || _isLoading)">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true"
                                             Style="width:16px; height:16px; color:white;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Style="font-size:18px;" />
                    }
                </button>
            </div>

            @* Footer note *@
            <MudText Typo="Typo.caption" Color="Color.Tertiary"
                     Style="font-size:10px; text-align:center; display:block; margin-top:6px;">
                DX365 runs locally on your DX server · @_chatHistory.Count turn@(_chatHistory.Count != 1 ? "s" : "") in history · Shift+Enter for new line
            </MudText>

        </div>
    </div>

</div>


@code {
    // ── System Prompt ─────────────────────────────────────────────────────────

    private const string SystemPrompt = @"
    You are DX365, a Microsoft 365 Power Platform specialist at TDK Philippines Corporation (TPC),
    deployed by the Digital Transformation (DX) team.

    STRICT SCOPE RULE — READ THIS FIRST:
    You ONLY answer questions about Microsoft 365 Power Platform and its components.
    If the user asks about ANYTHING outside this scope — including Tableau, Python, general IT,
    greetings about other topics, or any non-M365 subject — you MUST reply with exactly:
    'Sorry, I can only assist with Microsoft 365 Power Platform related questions.'
    Do NOT engage, explain, or offer alternatives. Just reply with that sentence and stop.

    IN-SCOPE TOPICS (answer these):
    Power Apps, Power Automate, Power BI, Power Pages, Dataverse,
    SharePoint integration, Teams integration, OneDrive, M365 connectors, DLP, ALM.

    OUT-OF-SCOPE TOPICS (refuse these — no exceptions):
    Tableau, Excel standalone, Python, SQL servers, non-M365 tools,
    general programming, HR systems, personal questions, small talk unrelated to M365.

    CONTEXT:
    TPC uses Microsoft 365. Users are beginners to intermediate.
    Internal apps run on SharePoint and Dataverse.
    DX team manages the Power Platform environment for TPC and Japan HQ.

    RULES:
    - Respond in English. Use Taglish only if the user does first.
    - Give step-by-step answers for technical questions.
    - Mention Premium licensing when relevant.
    - Never invent features or connectors that do not exist in M365.
    - If the question is too broad, ask one clarifying question first.

    FORMAT: Plain text only. No markdown. Put formulas and code on their own line.

    EXAMPLES OF CORRECT BEHAVIOR:
    User:  'Can you help me with Tableau?' → 'Sorry, I can only assist with Microsoft 365 Power Platform related questions.'
    User: 'Who are you?' → 'I am DX365, your M365 Power Platform assistant at TPC. Ask me anything about Power Apps, Power Automate, Power BI, Power Pages, or Dataverse.'
    User: 'How do I create a flow?' → Give a proper step-by-step Power Automate answer.
    '";

    // ── Suggestion Prompts ────────────────────────────────────────────────────

    private readonly List<string> _suggestions = new()
    {
        "How do I create an approval flow in Power Automate?",
        "What is the difference between Power Apps Canvas and Model-driven?",
        "How do I connect Power Apps to SharePoint?",
        "Explain DAX CALCULATE function with an example",
        "How to set up Row-Level Security in Power BI?",
        "What connectors require a Premium license?",
        "How do I use Dataverse as a backend for Power Apps?",
        "How to deploy a solution to another environment?",
    };

    // ── State ─────────────────────────────────────────────────────────────────

    private string _userInput     = string.Empty;
    private string _activeModel   = "qwen3:8b";
    private bool   _isLoading     = false;
    private bool   _isOnline      = false;

    private List<string>            _availableModels = new();
    private List<OllamaChatMessage> _chatHistory     = new();
    private List<OllamaChatMessage> _messages        = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _isOnline        = await OllamaService.IsAvailableAsync();
        _availableModels = await OllamaService.GetAvailableModelsAsync();

        if (_availableModels.Any())
            _activeModel = _availableModels.Contains("qwen3:8b")
                ? "qwen3:8b"
                : _availableModels.First();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Scroll chat to bottom after each render
        if (_messages.Any())
            await JS.InvokeVoidAsync("eval",
                "var el=document.getElementById('chat-area'); if(el) el.scrollTop=el.scrollHeight;");
    }

    // ── Actions ───────────────────────────────────────────────────────────────

    private async Task UseSuggestion(string text)
    {
        _userInput = text;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        var input = _userInput.Trim();
        if (string.IsNullOrWhiteSpace(input) || _isLoading) return;

        _userInput = string.Empty;
        _isLoading = true;

        _messages.Add(new OllamaChatMessage { Role = "user", Content = input });
        StateHasChanged();

        try
        {
            var response = await OllamaService.ChatAsync(new OllamaChatRequest
            {
                Model         = _activeModel,
                SystemMessage = SystemPrompt,
                ChatHistory   = _chatHistory,
                UserMessage   = input,
                Temperature   = 0.5,      // focused, professional answers
                TopK          = 20,
                TopP          = 0.95,
                RepeatPenalty = 1.0,
                NumPredict    = 800,      // M365 answers can be detailed
                NumCtx        = 8192,     // enough for long technical conversations
                Think         = false
            });

            if (response.IsSuccess)
            {
                _messages.Add(new OllamaChatMessage
                {
                    Role    = "assistant",
                    Content = response.Reply
                });
                _chatHistory = response.UpdatedHistory;
            }
            else
            {
                _messages.Add(new OllamaChatMessage
                {
                    Role    = "_error",
                    Content = $"Service error: {response.ErrorMessage}"
                });
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new OllamaChatMessage
            {
                Role    = "_error",
                Content = $"Unexpected error: {ex.Message}"
            });
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private void ClearHistory()
    {
        _chatHistory.Clear();
        _messages.Clear();
        StateHasChanged();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static bool IsJson(string text)
    {
        var t = text.TrimStart();
        return t.StartsWith("{") || t.StartsWith("[");
    }
}
