@page "/agents"
@using MudBlazor
@inject NavigationManager Nav

<PageTitle>DX AI Agents Portal</PageTitle>

@* ── How It Works Dialog ── *@
<MudDialog @bind-Visible="_showHowItWorks" Options="_dialogOptions">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="color:#1F4E79;" />
            <MudText Typo="Typo.h6" Style="font-weight:500;">How AI Agents Work</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Every message you send goes through this pipeline — fully processed on the DX local server.
            Nothing leaves your network.
        </MudText>

        <MudTimeline TimelinePosition="TimelinePosition.Start">

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Keyboard">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #e0e0e0; border-radius:10px;" Class="pa-3 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#E6F1FB; color:#0C447C; font-size:10px; height:20px;">Step 1</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">User Input</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            The user types a natural language message — in English, Filipino, or Taglish.
                            No special commands or forms required.
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#185FA5; font-style:italic;" Class="mt-1">
                            e.g. "Pakita ang attendance ni Juan ngayong buwan"
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Memory">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #e0e0e0; border-radius:10px;" Class="pa-3 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#E6F1FB; color:#0C447C; font-size:10px; height:20px;">Step 2</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">AI Model — Powered by Ollama</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            The message is sent to a locally hosted AI model running on the DX Server via Ollama.
                            All processing happens on-premise — no internet, no third-party services.
                        </MudText>
                        <MudStack Row="true" Spacing="1" Class="mt-2">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px; height:18px;">Qwen3 8B</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px; height:18px;">Gemma3 1B</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="font-size:10px; height:18px;">Llama 3.1 8B</MudChip>
                        </MudStack>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.AccountTree">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #e0e0e0; border-radius:10px;" Class="pa-3 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#E6F1FB; color:#0C447C; font-size:10px; height:20px;">Step 3</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">Intent Detection</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            The AI classifies the user's message into a specific intent and extracts
                            structured parameters — Employee ID, date range, department — returning clean JSON.
                        </MudText>
                        <MudPaper Elevation="0" Class="pa-2 mt-2"
                                  Style="background:#F5F7FA; border-radius:6px; font-family:monospace; font-size:11px; color:#2E4057; line-height:1.6;">
                            @("{") <br />
                            &nbsp;&nbsp;"Intent": "attendance",<br />
                            &nbsp;&nbsp;"EmployeeId": "01026791",<br />
                            &nbsp;&nbsp;"DateFrom": "2025-04-01"<br />
                            @("}")
                        </MudPaper>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.Settings">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #e0e0e0; border-radius:10px;" Class="pa-3 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#E6F1FB; color:#0C447C; font-size:10px; height:20px;">Step 4</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">System Processing</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Parameters are passed to the appropriate bot function. The system executes
                            business logic — calculations, internal methods, database queries —
                            with no AI involvement in the data retrieval step.
                        </MudText>
                        <MudStack Row="true" Spacing="1" Class="mt-2" Style="flex-wrap:wrap;">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Style="font-size:10px; height:18px;" Icon="@Icons.Material.Filled.Calculate">Calculations</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Style="font-size:10px; height:18px;" Icon="@Icons.Material.Filled.Storage">Database queries</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Style="font-size:10px; height:18px;" Icon="@Icons.Material.Filled.Code">Business logic</MudChip>
                        </MudStack>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.CallSplit">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #e0e0e0; border-radius:10px;" Class="pa-3 mb-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#FAEEDA; color:#633806; font-size:10px; height:20px;">Step 5</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">Response Decision</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            The system decides how to present the result based on the output type needed.
                        </MudText>
                        <MudPaper Elevation="0" Class="pa-2 mb-2"
                                  Style="border-left:3px solid #639922; border-radius:0 6px 6px 0; background:#F6FBF0;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size:14px; color:#3B6D11;" />
                                <MudText Typo="Typo.caption" Style="font-weight:500; color:#27500A;">AI-Enhanced Response</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Raw data passed back to AI to compose a human-friendly summary.
                                No hallucination risk — data is already computed.
                            </MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-2"
                                  Style="border-left:3px solid #185FA5; border-radius:0 6px 6px 0; background:#F0F6FC;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.TableChart" Style="font-size:14px; color:#185FA5;" />
                                <MudText Typo="Typo.caption" Style="font-weight:500; color:#0C447C;">Programmed Output</MudText>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Structured data displayed directly via pre-defined UI components — fast and precise.
                            </MudText>
                        </MudPaper>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

            <MudTimelineItem Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.CheckCircle">
                <ItemContent>
                    <MudPaper Elevation="0" Style="border:0.5px solid #c8e6c9; border-radius:10px; background:#F6FBF0;" Class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#EAF3DE; color:#27500A; font-size:10px; height:20px;">Result</MudChip>
                            <MudText Typo="Typo.subtitle2" Style="font-weight:500;">Answer Displayed to User</MudText>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Final response shown in the chat interface. Full pipeline runs on the local server.
                            No data ever touches the internet.
                        </MudText>
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>

        </MudTimeline>

        <MudPaper Elevation="0" Class="pa-3 mt-2"
                  Style="border:0.5px solid #c8e6c9; border-radius:8px; background:#F6FBF0;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:#3B6D11; font-size:18px;" />
                <MudText Typo="Typo.caption" Style="color:#27500A;">
                    <strong>100% on-premise.</strong> The AI model, database, and all processing run
                    on your DX server. No employee data is ever sent outside your network.
                </MudText>
            </MudStack>
        </MudPaper>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Style="background:#1F4E79; color:white; text-transform:none; border-radius:6px;"
                   OnClick="@(() => _showHowItWorks = false)">
            Got it
        </MudButton>
    </DialogActions>
</MudDialog>

@* ── Top App Bar ── *@
<MudAppBar Elevation="0" Color="Color.Surface" Style="border-bottom: 1px solid #e0e0e0;">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudPaper Width="36px" Height="36px"
                  Style="background:#1F4E79; border-radius:8px; display:flex; align-items:center; justify-content:center;"
                  Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.GridView" Style="color:white; font-size:20px;" />
        </MudPaper>
        <MudText Typo="Typo.h6" Style="font-weight:500; letter-spacing:-0.01em;">
            <span style="color:#1F4E79;">DX</span> AI Agents Portal
        </MudText>
    </MudStack>

    <MudSpacer />

    <MudTooltip Text="How AI Agents work" Placement="Placement.Bottom">
        <MudIconButton Icon="@Icons.Material.Outlined.Help"
                       Color="Color.Default"
                       Size="Size.Medium"
                       OnClick="@(() => _showHowItWorks = true)"
                       Class="mr-2" />
    </MudTooltip>

    <MudChip T="string"
             Icon="@Icons.Material.Filled.Lock"
             Color="Color.Success"
             Variant="Variant.Filled"
             Size="Size.Small"
             Style="font-size:11px;">
        Locally Deployed · No External Access
    </MudChip>
</MudAppBar>

@* ── Hero Section ── *@
<MudPaper Elevation="0" Style="border-bottom: 1px solid #e0e0e0;" Class="pa-6">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.h4" Style="font-weight:500; letter-spacing:-0.02em;" GutterBottom="true">
            Your <span style="color:#1F4E79;">AI Agents</span>, running locally
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="max-width:560px;" Class="mb-4">
            All agents are powered by pre-trained open-source models deployed on your local DX server.
            Your data never leaves the network.
        </MudText>
        <MudStack Row="true" Spacing="6">
            <div>
                <MudText Typo="Typo.h5" Style="color:#1F4E79; font-weight:500;">@Agents.Count</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total agents</MudText>
            </div>
            <div>
                <MudText Typo="Typo.h5" Style="color:#1F4E79; font-weight:500;">@Agents.Count(a => a.Status == AgentStatus.Online)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Online</MudText>
            </div>
            <div>
                <MudText Typo="Typo.h5" Style="color:#1F4E79; font-weight:500;">@Agents.Select(a => a.Department).Distinct().Count()</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Departments</MudText>
            </div>
        </MudStack>
    </MudContainer>
</MudPaper>

@* ── Main Content ── *@
<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    @* Filter Row *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudChipSet T="string" @bind-SelectedValue="_activeFilter" SelectionMode="SelectionMode.SingleSelection">
            @foreach (var dept in Departments)
            {
                <MudChip T="string"
                         Value="@dept"
                         Color="@(_activeFilter == dept ? Color.Primary : Color.Default)"
                         Variant="@(_activeFilter == dept ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetFilter(dept))">
                    @dept
                </MudChip>
            }
        </MudChipSet>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @FilteredAgents.Count() agent@(FilteredAgents.Count() != 1 ? "s" : "")
        </MudText>
    </MudStack>

    @* Agent Cards Grid *@
    <MudGrid Spacing="3">
        @foreach (var agent in FilteredAgents)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="0"
                         Style="border: 0.5px solid #e0e0e0; height:100%; display:flex; flex-direction:column;"
                         Class="rounded-lg">
                    <MudCardContent Style="flex:1;">

                        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudPaper Width="40px" Height="40px"
                                      Style="@($"background:{GetDeptIconBg(agent.Department)}; border-radius:8px; display:flex; align-items:center; justify-content:center;")"
                                      Elevation="0">
                                <MudIcon Icon="@GetDeptIcon(agent.Department)"
                                         Style="@($"color:{GetDeptIconColor(agent.Department)}; font-size:20px;")" />
                            </MudPaper>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <div style="@($"width:7px; height:7px; border-radius:50%; background:{GetStatusColor(agent.Status)};")" />
                                <MudText Typo="Typo.caption" Style="@($"color:{GetStatusTextColor(agent.Status)};")">
                                    @agent.Status.ToString()
                                </MudText>
                            </MudStack>
                        </MudStack>

                        @* Badge for featured agents *@
                        @if (agent.IsFeatured)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                     Style="background:#1F4E79; color:white; font-size:10px; height:18px; margin-bottom:6px;">
                                @agent.Badge
                            </MudChip>
                        }

                        <MudText Typo="Typo.subtitle2" Style="font-weight:500;" GutterBottom="true">
                            @agent.Name
                        </MudText>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height:1.55;">
                            @agent.Description
                        </MudText>

                    </MudCardContent>

                    <MudDivider />
                    <MudCardActions Class="px-4 py-2">

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Memory"
                                     Size="Size.Small"
                                     Style="font-size:14px; opacity:0.45;" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@agent.Model</MudText>
                        </MudStack>

                        <MudSpacer />

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Style="@($"background:{GetDeptChipBg(agent.Department)}; color:{GetDeptChipColor(agent.Department)}; font-size:10px; height:20px;")"
                                 DisableRipple="true"
                                 Class="mr-1">
                            @agent.Department
                        </MudChip>

                        @if (agent.Status == AgentStatus.Online)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Size="Size.Small"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       Style="background:#1F4E79; color:white; font-size:11px; height:28px; min-width:72px; text-transform:none; border-radius:6px;"
                                       OnClick="@(() => Launch(agent))">
                                Launch
                            </MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="@GetDisabledTooltip(agent.Status)" Placement="Placement.Top">
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Disabled="true"
                                           Style="font-size:11px; height:28px; min-width:80px; text-transform:none; border-radius:6px;">
                                    @agent.Status.ToString()
                                </MudButton>
                            </MudTooltip>
                        }

                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudDivider Class="mb-3 mt-6" />
    <MudStack Row="true" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.caption" Color="Color.Tertiary">DX AI Agents Portal · Internal use only</MudText>
        <MudText Typo="Typo.caption" Color="Color.Tertiary">All models run on local infrastructure · Powered by Ollama</MudText>
    </MudStack>

</MudContainer>


@code {

    // ── Dialog ────────────────────────────────────────────────────────────────

    private bool _showHowItWorks = false;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = true
    };

    // ── Filter ────────────────────────────────────────────────────────────────

    private string _activeFilter = "All";

    private IEnumerable<string> Departments =>
        new[] { "All" }.Concat(Agents.Select(a => a.Department).Distinct());

    private IEnumerable<AgentModel> FilteredAgents =>
        _activeFilter == "All"
            ? Agents
            : Agents.Where(a => a.Department == _activeFilter);

    private void SetFilter(string dept)
    {
        _activeFilter = dept;
        StateHasChanged();
    }

    // ── Navigation ────────────────────────────────────────────────────────────

    private void Launch(AgentModel agent) => Nav.NavigateTo(agent.Route);

    // ── Agent Data ────────────────────────────────────────────────────────────

    private List<AgentModel> Agents { get; } = new()
    {
        // ── HR ────────────────────────────────────────────────────────────────

        new AgentModel(
            Name:        "TPC HERA",
            Description: "AI-powered Human Resources Assistant. Ask anything about HR policies, attendance, leave balances, or workforce guidelines — in English or Taglish.",
            Model:       "Qwen3 8B",
            Department:  "HR",
            Status:      AgentStatus.Online,
            Route:       "/agent/hera",
            IsFeatured:  true,
            Badge:       "AI HR Assistant",
            IsActive : true),

        new AgentModel(
            Name:        "HR General Bot",
            Description: "Quick answers to general HR inquiries — company guidelines, benefits overview, onboarding information, and common HR FAQs.",
            Model:       "Gemma3 1B",
            Department:  "HR",
            Status:      AgentStatus.Offline,
            Route:       "/agent/hr-general",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        // ── DX ────────────────────────────────────────────────────────────────

        new AgentModel(
            Name:        "Ollama Test",
            Description: "Developer sandbox for testing locally hosted AI models directly. Configure model, system prompt, temperature, and parameters in real time.",
            Model:       "All installed model",
            Department:  "DX",
            Status:      AgentStatus.Online,
            Route:       "/ollama-test",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : true),

        new AgentModel(
            Name:        "M365 Power Platform Bot",
            Description: "Assists with Microsoft 365 Power Platform queries — Power Apps, Power Automate, Power BI, and integration support for DX-managed workflows.",
            Model:       "Llama 3.1 8B",
            Department:  "DX",
            Status:      AgentStatus.Online,
            Route:       "/agent/power-platform",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : true),

        new AgentModel(
            Name:        "Tableau Assistant",
            Description: "Helps users navigate Tableau dashboards, understand data visualizations, and get quick insights from published reports across departments.",
            Model:       "Qwen3 8B",
            Department:  "DX",
            Status:      AgentStatus.Maintenance,
            Route:       "/agent/tableau",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : true),

        // ── Finance ───────────────────────────────────────────────────────────

        new AgentModel(
            Name:        "Finance Query Bot",
            Description: "Answer questions about budget allocations, expense categories, department spending summaries, and financial report interpretation.",
            Model:       "Qwen3 8B",
            Department:  "Finance",
            Status:      AgentStatus.Offline,
            Route:       "/agent/finance",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        new AgentModel(
            Name:        "Payroll Assistant",
            Description: "Retrieve payroll computation details, deductions breakdown, and net pay summaries. Supports queries per employee or department.",
            Model:       "Qwen3 8B",
            Department:  "Finance",
            Status:      AgentStatus.Offline,
            Route:       "/agent/payroll",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        // ── IT ────────────────────────────────────────────────────────────────

        new AgentModel(
            Name:        "IT Helpdesk Bot",
            Description: "First-line support for common IT issues — ticket classification, troubleshooting guides, escalation routing, and system access requests.",
            Model:       "Llama 3.1 8B",
            Department:  "IT",
            Status:      AgentStatus.Offline,
            Route:       "/agent/helpdesk",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        new AgentModel(
            Name:        "Asset Inventory Bot",
            Description: "Query hardware and software assets assigned to employees or departments. Check asset status, assignment history, and inventory records.",
            Model:       "Gemma3 1B",
            Department:  "IT",
            Status:      AgentStatus.Offline,
            Route:       "/agent/assets",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        // ── Operations ────────────────────────────────────────────────────────

        new AgentModel(
            Name:        "Operations Report Bot",
            Description: "Summarizes operational KPIs, shift reports, and daily production data. Ask in natural language to get a quick snapshot of any operational metric.",
            Model:       "Qwen3 8B",
            Department:  "Operations",
            Status:      AgentStatus.Offline,
            Route:       "/agent/operations",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),

        new AgentModel(
            Name:        "Compliance Assistant",
            Description: "Guides employees on regulatory compliance requirements, internal audit checklists, and policy adherence procedures across departments.",
            Model:       "Llama 3.1 8B",
            Department:  "Operations",
            Status:      AgentStatus.Offline,
            Route:       "/agent/compliance",
            IsFeatured:  false,
            Badge:       string.Empty,
            IsActive : false),
    };

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string GetDisabledTooltip(AgentStatus status) => status switch
    {
        AgentStatus.Maintenance => "Under maintenance — check back later",
