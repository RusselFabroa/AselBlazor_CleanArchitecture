@page "/"
@layout Layout.MainLayout

<PageTitle>AselDev Blazor</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="home-shell px-0">
    <section class="hero-surface">
        <div class="hero-copy">
            <div class="eyebrow">AselDev Blazor</div>
            <MudText Typo="Typo.h3" HtmlTag="h1" Class="hero-title">
                Clean Architecture template with company-ready SSO.
            </MudText>
            <MudText Typo="Typo.body1" Class="hero-subtitle">
                A practical .NET Blazor foundation for internal apps, shared identity, JWT security, user administration, and modular growth.
            </MudText>

            <div class="hero-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/login"
                           StartIcon="@Icons.Material.Outlined.Login">
                    Sign In
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Href="/users"
                           StartIcon="@Icons.Material.Outlined.Group">
                    Manage Users
                </MudButton>
            </div>
        </div>

        <div class="identity-panel">
            <div class="panel-header">
                <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" />
                <div>
                    <strong>Identity Provider</strong>
                    <span>One login for company modules</span>
                </div>
            </div>

            <div class="mini-metric-grid">
                <div>
                    <span>Login</span>
                    <strong>Employee ID</strong>
                </div>
                <div>
                    <span>Token</span>
                    <strong>JWT</strong>
                </div>
                <div>
                    <span>Access</span>
                    <strong>Roles</strong>
                </div>
            </div>

            <div class="endpoint-list">
                <code>POST /api/sso/token</code>
                <code>GET /api/sso/me</code>
                <code>GET /api/sso/.well-known</code>
            </div>
        </div>
    </section>

    <section class="quick-grid">
        <article class="quick-card accent-blue">
            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
            <div>
                <h2>Clean Layers</h2>
                <p>Domain, Application, Infrastructure, and Web stay separated so modules can grow without tangling business logic.</p>
            </div>
        </article>

        <article class="quick-card accent-green">
            <MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" />
            <div>
                <h2>Admin Users</h2>
                <p>Admins create users, assign roles, and keep employee-based login centralized in one place.</p>
            </div>
        </article>

        <article class="quick-card accent-amber">
            <MudIcon Icon="@Icons.Material.Outlined.Hub" />
            <div>
                <h2>SSO Ready</h2>
                <p>Other apps can trust issued JWTs and read shared profile claims through the SSO user info endpoint.</p>
            </div>
        </article>
    </section>

    <section class="content-grid">
        <article class="section-card">
            <div class="section-card-title">
                <span>Architecture</span>
                <MudIcon Icon="@Icons.Material.Outlined.Schema" />
            </div>

            <div class="layer-list">
                @foreach (var layer in _layers)
                {
                    <div>
                        <strong>@layer.Name</strong>
                        <span>@layer.Description</span>
                    </div>
                }
            </div>
        </article>

        <article class="section-card">
            <div class="section-card-title">
                <span>SSO Flow</span>
                <MudIcon Icon="@Icons.Material.Outlined.Key" />
            </div>

            <div class="sso-flow">
                <div>
                    <strong>1</strong>
                    <span>User signs in through AselDev Identity.</span>
                </div>
                <div>
                    <strong>2</strong>
                    <span>Identity issues a signed JWT with employee, department, and role claims.</span>
                </div>
                <div>
                    <strong>3</strong>
                    <span>Company modules validate the token and authorize access locally.</span>
                </div>
            </div>
        </article>
    </section>

    <section class="section-card full-card">
        <div class="section-card-title">
            <span>Shared Token Claims</span>
            <MudIcon Icon="@Icons.Material.Outlined.Badge" />
        </div>

        <div class="claim-list">
            @foreach (var claim in _claims)
            {
                <span>@claim</span>
            }
        </div>
    </section>
</MudContainer>

<style>
    :root {
        --home-text: #111827;
        --home-muted: #667085;
        --home-line: #E5E7EB;
        --home-soft: #F7F9FC;
        --home-blue: #2563EB;
        --home-green: #0F766E;
        --home-amber: #B45309;
        --home-violet: #6D28D9;
    }

    .home-shell {
        color: var(--home-text);
        display: grid;
        gap: 18px;
        padding-bottom: 28px;
    }

    .hero-surface {
        background:
            linear-gradient(135deg, rgba(37,99,235,0.10), rgba(15,118,110,0.08)),
            #FFFFFF;
        border: 1px solid var(--home-line);
        border-radius: 8px;
        display: grid;
        gap: 20px;
        grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
        margin: 0 auto;
        max-width: 1180px;
        padding: clamp(22px, 4vw, 40px);
        width: 100%;
    }

    .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
    }

    .eyebrow {
        color: var(--home-blue);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .hero-title {
        color: var(--home-text);
        font-weight: 800;
        line-height: 1.08;
        max-width: 760px;
    }

    .hero-subtitle {
        color: var(--home-muted);
        line-height: 1.6;
        max-width: 680px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 4px;
    }

    .hero-actions .mud-button-root {
        border-radius: 8px !important;
        box-shadow: none !important;
        font-weight: 700 !important;
    }

    .identity-panel,
    .quick-card,
    .section-card {
        background: rgba(255,255,255,0.95);
        border: 1px solid var(--home-line);
        border-radius: 8px;
        box-shadow: 0 10px 24px rgba(17,24,39,0.06);
    }

    .identity-panel {
        display: grid;
        gap: 16px;
        padding: 18px;
    }

    .panel-header {
        align-items: center;
        display: flex;
        gap: 12px;
    }

    .panel-header .mud-icon-root {
        color: var(--home-green);
        font-size: 2rem;
    }

    .panel-header strong,
    .panel-header span {
        display: block;
    }

    .panel-header strong {
        font-weight: 800;
    }

    .panel-header span {
        color: var(--home-muted);
        font-size: 0.85rem;
    }

    .mini-metric-grid {
        display: grid;
        gap: 10px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .mini-metric-grid div {
        background: var(--home-soft);
        border: 1px solid var(--home-line);
        border-radius: 8px;
        padding: 10px;
    }

    .mini-metric-grid span,
    .mini-metric-grid strong {
        display: block;
    }

    .mini-metric-grid span {
        color: var(--home-muted);
        font-size: 0.72rem;
    }

    .mini-metric-grid strong {
        font-size: 0.86rem;
        font-weight: 800;
        margin-top: 2px;
    }

    .endpoint-list {
        display: grid;
        gap: 8px;
    }

    .endpoint-list code {
        background: #111827;
        border-radius: 8px;
        color: #E5E7EB;
        display: block;
        font-size: 0.78rem;
        padding: 9px 10px;
        white-space: normal;
    }

    .quick-grid,
    .content-grid,
    .full-card {
        margin: 0 auto;
        max-width: 1180px;
        width: 100%;
    }

    .quick-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .quick-card {
        align-items: flex-start;
        display: flex;
        gap: 12px;
        padding: 16px;
    }

    .quick-card .mud-icon-root {
        flex: 0 0 auto;
        font-size: 1.55rem;
        margin-top: 2px;
    }

    .quick-card h2 {
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.25;
        margin: 0 0 5px;
    }

    .quick-card p {
        color: var(--home-muted);
        font-size: 0.86rem;
        line-height: 1.5;
        margin: 0;
    }

    .accent-blue .mud-icon-root {
        color: var(--home-blue);
    }

    .accent-green .mud-icon-root {
        color: var(--home-green);
    }

    .accent-amber .mud-icon-root {
        color: var(--home-amber);
    }

    .content-grid {
        display: grid;
        gap: 14px;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .section-card {
        padding: 18px;
    }

    .section-card-title {
        align-items: center;
        border-bottom: 1px solid var(--home-line);
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
        padding-bottom: 10px;
    }

    .section-card-title span {
        font-size: 1rem;
        font-weight: 800;
    }

    .section-card-title .mud-icon-root {
        color: var(--home-violet);
    }

    .layer-list,
    .sso-flow {
        display: grid;
        gap: 10px;
    }

    .layer-list div,
    .sso-flow div {
        background: var(--home-soft);
        border: 1px solid var(--home-line);
        border-radius: 8px;
        padding: 12px;
    }

    .layer-list strong,
    .layer-list span {
        display: block;
    }

    .layer-list strong {
        font-weight: 800;
        margin-bottom: 3px;
    }

    .layer-list span,
    .sso-flow span {
        color: var(--home-muted);
        font-size: 0.86rem;
        line-height: 1.45;
    }

    .sso-flow div {
        align-items: flex-start;
        display: grid;
        gap: 10px;
        grid-template-columns: auto 1fr;
    }

    .sso-flow strong {
        align-items: center;
        background: var(--home-blue);
        border-radius: 8px;
        color: #FFFFFF;
        display: inline-flex;
        font-size: 0.8rem;
        height: 28px;
        justify-content: center;
        width: 28px;
    }

    .claim-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .claim-list span {
        background: #EEF2FF;
        border: 1px solid #C7D2FE;
        border-radius: 8px;
        color: #3730A3;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 7px 10px;
    }

    @@media (max-width: 960px) {
        .hero-surface,
        .quick-grid,
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .hero-actions {
            flex-direction: column;
        }

        .hero-actions .mud-button-root {
            width: 100%;
        }

        .mini-metric-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private readonly List<LayerItem> _layers = new()
    {
        new("Domain", "Entities, core rules, interfaces, and business boundaries."),
        new("Application", "DTOs, use cases, service contracts, and workflow orchestration."),
        new("Infrastructure", "EF Core, Identity, JWT, logging, and external adapters."),
        new("Web", "Blazor pages, layouts, controllers, routing, and authorization.")
    };

    private readonly List<string> _claims = new()
    {
        "sub",
        "employee_id",
        "preferred_username",
        "name",
        "email",
        "department",
        "role",
        "jti"
    };

    private record LayerItem(string Name, string Description);
}
