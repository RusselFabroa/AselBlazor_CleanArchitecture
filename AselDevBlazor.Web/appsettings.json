{
  "SystemSettings": {
    "SystemBaseUrl": "https://localhost:7176/"
  },


  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "SystemLogs/aseldevlogs-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "DynamicConnectionStrings": {
    "DefaultConnection": {
      "Provider": "mysql",
      "ConnectionString": "server=10.111.3.211;port=3307;uid=epdxadmin2;database=aseldev_trial_data_db;pwd=epdxteam2025!;ConvertZeroDateTime=True;"
    },
    "AnotherConnection": {
      "Provider": "sqlserver",
      "ConnectionString": "Server=your_sql_server;Database=your_database;User Id=your_user;Password=your_password;"
    }
  },

  "AllowedHosts": "*",
  "JwtSettings": {
    "Key": "YourSuperSecretKeyHereMustBeAtLeast32Characters!",
    "Issuer": "AselDevBlazor",
    "Audience": "AselDevBlazorUsers",
    "ExpiryInMinutes": 480
  }
}